		"status=0" \
		"cmd=xtp.reply" \
		"self call ok" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	s_out=$("$s_probe_exe" 127.0.0.1 "$i_tls_port" 2>&1) || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload tls_listener_added : probe failed"
		return 1
	}
	proc_check_output_tokens \
		"$s_exe_name xtp_tls_listener_soft_reload tls_listener_added" \
		"$s_out" \
		"status=open" \
		"port=$i_tls_port" \
		"" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name xtp_tls_listener_soft_reload_restore_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name xtp_tls_listener_soft_reload_restore_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name xtp_tls_listener_soft_reload_restore_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload restore_idle_after : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload restore_status : missing text '\"message\":\"target server soft reload success\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name xtp_tls_listener_soft_reload_restore_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name xtp_tls_listener_soft_reload_restore_status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		rm -f "$s_config_backup"
		return 1
	}

	s_out=$(proc_run_client_retry "$s_client_exe" 10 127.0.0.1 "$XTP_PORT" demo.callself tag=tls-soft-reload-restore 2>&1) || {
		rm -f "$s_config_backup"
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload restore_client : client exit"
		return 1
	}
	proc_check_output_tokens \
		"$s_exe_name xtp_tls_listener_soft_reload restore_client" \
		"$s_out" \
		"status=0" \
		"cmd=xtp.reply" \
		"self call ok" || {
		rm -f "$s_config_backup"
		return 1
	}

	if s_out=$("$s_probe_exe" 127.0.0.1 "$i_tls_port" 2>&1); then
		rm -f "$s_config_backup"
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload tls_listener_restored : probe still open"
		return 1
	fi
	proc_check_output_tokens \
		"$s_exe_name xtp_tls_listener_soft_reload tls_listener_restored" \
		"$s_out" \
		"status=closed" \
		"port=$i_tls_port" \
		"" || {
		rm -f "$s_config_backup"
		return 1
	}

	rm -f "$s_config_backup"
	return 0
}

proc_run_named_server_numeric_field_soft_reload_check() {
	s_exe_name="$1"
	s_config="$2"
	s_server_name="$3"
	s_case_name="$4"
	s_field_name="$5"
	s_toggle_zero="$6"
	i_field_step="$7"
	i_field_zero_fallback="$8"
	s_client_exe="$9"
	shift 9
	s_client_arg1="${1:-}"
	s_client_arg2="${2:-}"
	s_client_arg3="${3:-}"
	s_client_arg4="${4:-}"
	s_expect1="${5:-}"
	s_expect2="${6:-}"
	s_expect3="${7:-}"
	s_config_path="$RELEASE_DIR/$s_config"
	s_config_backup="$TOOL_DIR/.${s_case_name}_${RUN_TAG}.json.bak"
	s_server_query=$(printf "%s" "$s_server_name" | sed 's/ /%20/g')
	i_field_old=""
	i_field_new=0
	s_out=""

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name $s_case_name config_path : missing"
		return 1
	fi

	i_field_old=$(awk -v s_server_name="$s_server_name" -v s_field_name="$s_field_name" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target ) {
		if ( match($0, "\"" s_field_name "\"[[:space:]]*:[[:space:]]*([0-9]+)", arr) ) {
			print arr[1]
			exit
		}
	}
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
' "$s_config_path")
	if [ -z "$i_field_old" ]; then
		echo "FAIL $s_exe_name $s_case_name ${s_field_name}_before : missing"
		return 1
	fi

	if [ "$s_toggle_zero" = "true" ]; then
		i_field_new=0
		if [ "$i_field_old" -eq 0 ]; then
			i_field_new="$i_field_zero_fallback"
		fi
	else
		i_field_new=$((i_field_old + i_field_step))
		if [ "$i_field_new" -eq "$i_field_old" ]; then
			if [ "$i_field_old" -eq 0 ] && [ "$i_field_zero_fallback" -gt 0 ]; then
				i_field_new="$i_field_zero_fallback"
			else
				i_field_new=$((i_field_old + 1))
			fi
		fi
	fi

	cp "$s_config_path" "$s_config_backup"
	if ! awk -v s_server_name="$s_server_name" -v s_field_name="$s_field_name" -v i_field_new="$i_field_new" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
	b_replaced = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target && !b_replaced && $0 ~ "\"" s_field_name "\"[[:space:]]*:[[:space:]]*[0-9]+" ) {
		sub(/:[[:space:]]*[0-9]+/, ": " i_field_new)
		b_replaced = 1
	}
	print
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
END {
	if ( !b_replaced ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : $s_field_name not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	if cmp -s "$s_config_backup" "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : $s_field_name not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name idle_after : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name $s_case_name status : missing text '\"message\":\"target server soft reload success\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if [ -n "$s_client_arg4" ]; then
		s_out=$(proc_run_client_retry "$s_client_exe" 10 "$s_client_arg1" "$s_client_arg2" "$s_client_arg3" "$s_client_arg4" 2>&1) || {
			echo "FAIL $s_exe_name $s_case_name client : client exit"
			cp "$s_config_backup" "$s_config_path"
			rm -f "$s_config_backup"
			return 1
		}
	else
		s_out=$(proc_run_client_retry "$s_client_exe" 10 "$s_client_arg1" "$s_client_arg2" "$s_client_arg3" 2>&1) || {
			echo "FAIL $s_exe_name $s_case_name client : client exit"
			cp "$s_config_backup" "$s_config_path"
			rm -f "$s_config_backup"
			return 1
		}
	fi
	proc_check_output_tokens "$s_exe_name $s_case_name client" "$s_out" "$s_expect1" "$s_expect2" "$s_expect3" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name restore_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name restore_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name restore_idle_after : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name $s_case_name restore_status : missing text '\"message\":\"target server soft reload success\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name restore_status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name restore_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		rm -f "$s_config_backup"
		return 1
	}

	if [ -n "$s_client_arg4" ]; then
		s_out=$(proc_run_client_retry "$s_client_exe" 10 "$s_client_arg1" "$s_client_arg2" "$s_client_arg3" "$s_client_arg4" 2>&1) || {
			echo "FAIL $s_exe_name $s_case_name restore_client : client exit"
			rm -f "$s_config_backup"
			return 1
		}
	else
		s_out=$(proc_run_client_retry "$s_client_exe" 10 "$s_client_arg1" "$s_client_arg2" "$s_client_arg3" 2>&1) || {
			echo "FAIL $s_exe_name $s_case_name restore_client : client exit"
			rm -f "$s_config_backup"
			return 1
		}
	fi
	proc_check_output_tokens "$s_exe_name $s_case_name restore_client" "$s_out" "$s_expect1" "$s_expect2" "$s_expect3" || {
		rm -f "$s_config_backup"
		return 1
	}

	rm -f "$s_config_backup"
	return 0
}

proc_run_manage_http_listener_soft_reload_check() {
	s_exe_name="$1"
	s_config="$2"
	s_server_name="$3"
	s_case_name="targeted_server_http_listener_soft_reload"
	s_config_path="$RELEASE_DIR/$s_config"
	s_config_backup="$TOOL_DIR/.${s_case_name}_${RUN_TAG}.json.bak"
	s_server_query=$(printf "%s" "$s_server_name" | sed 's/ /%20/g')
	i_field_old=""
	i_field_new=0
	i_status=0
	s_body=""

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name $s_case_name config_path : missing"
		return 1
	fi

	i_field_old=$(awk -v s_server_name="$s_server_name" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target ) {
		if ( match($0, "\"recv_limit\"[[:space:]]*:[[:space:]]*([0-9]+)", arr) ) {
			print arr[1]
			exit
		}
	}
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
' "$s_config_path")
	if [ -z "$i_field_old" ]; then
		echo "FAIL $s_exe_name $s_case_name recv_limit_before : missing"
		return 1
	fi

	i_field_new=$((i_field_old + 2048))
	if [ "$i_field_new" -eq "$i_field_old" ]; then
		i_field_new=$((i_field_old + 1))
	fi

	cp "$s_config_path" "$s_config_backup"
	if ! awk -v s_server_name="$s_server_name" -v i_field_new="$i_field_new" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
	b_replaced = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target && !b_replaced && $0 ~ "\"recv_limit\"[[:space:]]*:[[:space:]]*[0-9]+" ) {
		sub(/:[[:space:]]*[0-9]+/, ": " i_field_new)
		b_replaced = 1
	}
	print
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
END {
	if ( !b_replaced ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : recv_limit not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	if cmp -s "$s_config_backup" "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : recv_limit not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/json" '"path":"/json"'; then
		echo "FAIL $s_exe_name $s_case_name client_after : missing text '\"path\":\"/json\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name client" "$i_status" "200" "$s_body" '"path":"/json"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name restore_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name restore_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/json" '"path":"/json"'; then
		echo "FAIL $s_exe_name $s_case_name restore_client_after : missing text '\"path\":\"/json\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_client" "$i_status" "200" "$s_body" '"path":"/json"' || {
		rm -f "$s_config_backup"
		return 1
	}

	rm -f "$s_config_backup"
	return 0
}

proc_run_named_server_soft_reload_check() {
	proc_run_named_server_numeric_field_soft_reload_check \
		"$1" \
		"$2" \
		"$3" \
		"$4" \
		"idle_timeout" \
		"true" \
		0 \
		3000 \
		"$5" \
		"$6" \
		"$7" \
		"$8" \
		"$9" \
		"${10:-}" \
		"${11:-}" \
		"${12:-}"
}

proc_run_udp_recv_limit_reject_check() {
	s_exe_name="$1"
	s_config="$2"
	s_server_name="$3"
	s_client_exe="$4"
	s_client_host="$5"
	i_client_port="$6"
	i_recv_limit="${7:-64}"
	s_config_path="$RELEASE_DIR/$s_config"
	s_config_backup="$TOOL_DIR/.udp_recv_limit_reject_${RUN_TAG}.json.bak"
	s_server_query=$(printf "%s" "$s_server_name" | sed 's/ /%20/g')
	s_body=""
	s_out=""
	s_payload=""
	i_field_old=""
	i_field_new="$i_recv_limit"

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name udp_recv_limit_reject config_path : missing"
		return 1
	fi

	cp "$s_config_path" "$s_config_backup"

	i_field_old=$(awk -v s_server_name="$s_server_name" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target ) {
		if ( match($0, "\"recv_limit\"[[:space:]]*:[[:space:]]*([0-9]+)", arr) ) {
			print arr[1]
			exit
		}
	}
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
' "$s_config_backup")
	if [ -z "$i_field_old" ]; then
		echo "FAIL $s_exe_name udp_recv_limit_reject recv_limit_before : missing"
		rm -f "$s_config_backup"
		return 1
	fi

	if [ "$i_field_old" = "$i_field_new" ]; then
		i_field_new=$((i_recv_limit + 16))
	fi

	if ! awk -v s_server_name="$s_server_name" -v i_field_new="$i_field_new" '
function brace_delta(s,   i, c, d) {
	d = 0
	for ( i = 1; i <= length(s); i++ ) {
		c = substr(s, i, 1)
		if ( c == "{" ) {
			d++
		} else if ( c == "}" ) {
			d--
		}
	}
	return d
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
	b_replaced = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target && $0 ~ "\"recv_limit\"[[:space:]]*:[[:space:]]*[0-9]+" ) {
		sub(/"recv_limit"[[:space:]]*:[[:space:]]*[0-9]+/, "\"recv_limit\": " i_field_new)
		b_replaced = 1
	}
	print
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
END {
	if ( b_replaced == 0 ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name udp_recv_limit_reject config_replace : recv_limit not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	s_payload=$(printf "%*s" $((i_field_new + 32)) "" | tr ' ' 'R')

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name udp_recv_limit_reject idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name udp_recv_limit_reject reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name udp_recv_limit_reject idle_after : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name udp_recv_limit_reject status : missing text '\"message\":\"target server soft reload success\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name udp_recv_limit_reject status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if s_out=$("$s_client_exe" "$s_client_host" "$i_client_port" "$s_payload" 2>&1); then
		echo "FAIL $s_exe_name udp_recv_limit_reject client : expected reject"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	printf "OK   %s udp_recv_limit_reject client : 1\n" "$s_exe_name"
	proc_check "$s_exe_name udp_recv_limit_reject client body" "200" "200" "$s_out" 'recvfrom failed' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/udp_metrics")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics" "$i_status" "200" "$s_body" 'udp_recv_limit_reject_count=' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics reject" "200" "200" "$s_body" 'udp_reject_count=1' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics recv_limit" "200" "200" "$s_body" 'udp_recv_limit_reject_count=1' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics reason" "200" "200" "$s_body" 'udp_last_reject_reason=recv_limit' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics bytes" "200" "200" "$s_body" "udp_last_reject_bytes=${#s_payload}" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/udp_metrics_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics_json" "$i_status" "200" "$s_body" '"udp_recv_limit_reject_count"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics_json reject" "200" "200" "$s_body" '"udp_reject_count":1' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics_json recv_limit" "200" "200" "$s_body" '"udp_recv_limit_reject_count":1' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject udp_metrics_json reason" "200" "200" "$s_body" '"udp_last_reject_reason":"recv_limit"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name udp_recv_limit_reject restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject restore_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject restore_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name udp_recv_limit_reject restore_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name udp_recv_limit_reject restore_idle_after : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name udp_recv_limit_reject restore_status : missing text '\"message\":\"target server soft reload success\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name udp_recv_limit_reject restore_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name udp_recv_limit_reject restore_status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name udp_recv_limit_reject restore_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! s_out=$(proc_run_client_retry "$s_client_exe" 10 "$s_client_host" "$i_client_port" "smoke-udp-restored" 2>&1); then
		echo "FAIL $s_exe_name udp_recv_limit_reject restore_client : client exit"
		rm -f "$s_config_backup"
		return 1
	fi
	proc_check_output_tokens "$s_exe_name udp_recv_limit_reject restore_client" "$s_out" "udp demo" "data=smoke-udp-restored" "" || {
		rm -f "$s_config_backup"
		return 1
	}

	rm -f "$s_config_backup"
	return 0
}

proc_cleanup_servers() {
	if [ -n "$CLIENT_EXT" ]; then
		taskkill //F //T //IM "$XS_BIN" >/dev/null 2>&1 || true
		taskkill //F //T //IM "$XSDBG_BIN" >/dev/null 2>&1 || true
	fi

	proc_wait_not_ready >/dev/null 2>&1 || sleep 1
	rm -f "$BODY_FILE"
	rm -f "$HEADER_FILE"
}

proc_cleanup_generated_files() {
	rm -f \
		"$TOOL_DIR"/xtp_smoke_client \
		"$TOOL_DIR"/port_probe_client \
		"$TOOL_DIR"/ws_smoke_client \
		"$TOOL_DIR"/udp_smoke_client \
		"$TOOL_DIR"/custom_smoke_client \
		"$TOOL_DIR"/xtp_smoke_client*.exe \
		"$TOOL_DIR"/port_probe_client*.exe \
		"$TOOL_DIR"/ws_smoke_client*.exe \
		"$TOOL_DIR"/udp_smoke_client*.exe \
		"$TOOL_DIR"/custom_smoke_client*.exe \
		"$BODY_FILE" \
		"$HEADER_FILE"
}

proc_stop_server() {
	i_pid="$1"

	if [ -n "$CLIENT_EXT" ]; then
		taskkill //F //T //IM "$XS_BIN" >/dev/null 2>&1 || true
		taskkill //F //T //IM "$XSDBG_BIN" >/dev/null 2>&1 || true
	elif [ -n "$i_pid" ]; then
		kill "$i_pid" >/dev/null 2>&1 || true
	fi

	proc_wait_not_ready >/dev/null 2>&1 || sleep 1
	rm -f "$BODY_FILE"
	rm -f "$HEADER_FILE"
}

proc_build_c_client() {
	s_source="$1"
	s_output="$2"

	gcc "$TOOL_DIR/$s_source" -O2 -s $CLIENT_LIBS -o "$TOOL_DIR/$s_output$CLIENT_EXT"
	echo "$TOOL_DIR/$s_output$CLIENT_EXT"
}

proc_build_xtp_smoke_client() {
	proc_build_c_client "xtp_smoke_client.c" "xtp_smoke_client"
}

proc_build_port_probe_client() {
	proc_build_c_client "port_probe_client.c" "port_probe_client"
}

proc_build_ws_smoke_client() {
	proc_build_c_client "ws_smoke_client.c" "ws_smoke_client"
}

proc_build_udp_smoke_client() {
	proc_build_c_client "udp_smoke_client.c" "udp_smoke_client"
}
proc_build_custom_smoke_client() {
	proc_build_c_client "custom_smoke_client.c" "custom_smoke_client"
}

proc_run_client_retry() {
	s_client_exe="$1"
	i_max_try="$2"
	shift 2

	i_try=0
	s_out=""
	while [ "$i_try" -lt "$i_max_try" ]; do
		if s_out=$("$s_client_exe" "$@" 2>&1); then
			printf "%s" "$s_out"
			return 0
		fi

		i_try=$((i_try + 1))
		if [ "$i_try" -lt "$i_max_try" ]; then
			sleep 0.2
		fi
	done

	printf "%s" "$s_out"
	return 1
}

proc_run_helper_case() {
	s_exe_name="$1"
	s_config="$2"
	s_client_exe="$3"
	s_check_name="$4"
	shift 4

	s_exe_path="$RELEASE_DIR/$s_exe_name"
	i_case_exit=0

	if [ ! -f "$s_exe_path" ]; then
		echo "FAIL $s_exe_name $s_check_name : executable not found"
		return 1
	fi

	(
		cd "$RELEASE_DIR"
		proc_cleanup_servers
		"$s_exe_path" "$s_config" >/dev/null 2>&1 &
		i_pid=$!
		trap 'proc_stop_server "$i_pid"' EXIT INT TERM

		if ! proc_wait_ready; then
			echo "FAIL $s_exe_name $s_check_name : timeout"
			return 1
		fi

		sleep 1
		"$s_client_exe" "$@"
	)
}

proc_check() {
	s_name="$1"
	i_actual="$2"
	i_expect="$3"
	s_body="$4"
	s_expect_text="${5:-}"

	if [ "$i_actual" != "$i_expect" ]; then
		echo "FAIL $s_name : expected $i_expect, got $i_actual"
		return 1
	fi

	if [ -n "$s_expect_text" ] && ! printf "%s" "$s_body" | grep -F "$s_expect_text" >/dev/null 2>&1; then
		echo "FAIL $s_name : missing text '$s_expect_text'"
		return 1
	fi

	echo "OK   $s_name : $i_actual"
	return 0
}

proc_check_line_with_marker() {
	s_name="$1"
	s_path_text="$2"
	s_marker_text="$3"

	if grep -F "$s_path_text" "$INDEX_FILE" | grep -F "$s_marker_text" >/dev/null 2>&1; then
		echo "OK   $s_name : static"
		return 0
	fi

	echo "FAIL $s_name : missing '$s_marker_text' on '$s_path_text'"
	return 1
}

proc_run_bus_governance_scenario() {
	s_exe_name="$1"
	s_name_prefix="${2:-}"
	s_case_prefix="$s_exe_name"
	s_base_url="http://127.0.0.1:$PORT"
	s_readonly_namespace="stable.readonly.$RUN_TAG"
	s_disabled_namespace="stable.disabled.$RUN_TAG"
	s_ttl_namespace="stable.ttl.$RUN_TAG"
	s_tag_namespace="stable.tag.$RUN_TAG"
	s_data_tag="item1"
	s_tag_data_tag="item2"

	if [ -n "$s_name_prefix" ]; then
		s_case_prefix="$s_exe_name $s_name_prefix"
	fi

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/remove?all=true")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_remove_all_pre" "$i_status" "200" "$s_body" '"result":true' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/reset")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_reset_pre" "$i_status" "200" "$s_body" '"sweep_count"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/limits?readonly_namespaces=&disabled_namespaces=&ttl_required_namespaces=&tag_required_namespaces=&data_limit=0&queue_limit=0&namespace_limit=0&namespace_data_limit=0")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_limits_clear_pre" "$i_status" "200" "$s_body" '"updated":true' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_pre readonly" "200" "200" "$s_body" '"readonly_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_pre disabled" "200" "200" "$s_body" '"disabled_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_pre ttl" "200" "200" "$s_body" '"ttl_required_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_pre tag" "200" "200" "$s_body" '"tag_required_namespaces":""' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_readonly_namespace&tag=$s_data_tag")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_seed_register" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_case_prefix bus_policy_seed_register namespace" "200" "200" "$s_body" "\"namespace\":\"$s_readonly_namespace\"" || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/limits?readonly_namespaces=$s_readonly_namespace&disabled_namespaces=$s_disabled_namespace&ttl_required_namespaces=$s_ttl_namespace&tag_required_namespaces=$s_tag_namespace")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_limits_set" "$i_status" "200" "$s_body" '"updated":true' || return 1
	proc_check "$s_case_prefix bus_policy_limits_set readonly" "200" "200" "$s_body" "\"readonly_namespaces\":\"$s_readonly_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_set disabled" "200" "200" "$s_body" "\"disabled_namespaces\":\"$s_disabled_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_set ttl" "200" "200" "$s_body" "\"ttl_required_namespaces\":\"$s_ttl_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_set tag" "200" "200" "$s_body" "\"tag_required_namespaces\":\"$s_tag_namespace\"" || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/set?namespace=$s_readonly_namespace&tag=$s_data_tag&text=hello")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_readonly_set" "$i_status" "409" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_readonly_set body" "409" "409" "$s_body" '"bus_error":"namespace readonly"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_disabled_namespace&tag=$s_data_tag")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_disabled_register" "$i_status" "409" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_disabled_register body" "409" "409" "$s_body" '"bus_error":"namespace disabled"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_ttl_namespace&tag=$s_data_tag")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_ttl_missing" "$i_status" "409" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_ttl_missing body" "409" "409" "$s_body" '"bus_error":"namespace ttl required"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_ttl_namespace&tag=$s_data_tag&ttl=60")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_ttl_register" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_case_prefix bus_policy_ttl_register ttl" "200" "200" "$s_body" '"ttl":60' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_tag_namespace")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_tag_missing" "$i_status" "409" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_tag_missing body" "409" "409" "$s_body" '"bus_error":"namespace tag required"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/register?namespace=$s_tag_namespace&tag=$s_tag_data_tag")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_tag_register" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_case_prefix bus_policy_tag_register tag" "200" "200" "$s_body" "\"tag\":\"$s_tag_data_tag\"" || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/limits")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_limits_verify" "$i_status" "200" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify readonly_count" "200" "200" "$s_body" '"readonly_namespace_reject_count":1' || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify readonly_namespace" "200" "200" "$s_body" "\"last_readonly_namespace\":\"$s_readonly_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify readonly_action" "200" "200" "$s_body" '"last_readonly_namespace_action":"set"' || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify disabled_count" "200" "200" "$s_body" '"disabled_namespace_reject_count":1' || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify disabled_namespace" "200" "200" "$s_body" "\"last_disabled_namespace\":\"$s_disabled_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify ttl_count" "200" "200" "$s_body" '"ttl_required_namespace_reject_count":1' || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify ttl_namespace" "200" "200" "$s_body" "\"last_ttl_required_namespace\":\"$s_ttl_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify tag_count" "200" "200" "$s_body" '"tag_required_namespace_reject_count":1' || return 1
	proc_check "$s_case_prefix bus_policy_limits_verify tag_namespace" "200" "200" "$s_body" "\"last_tag_required_namespace\":\"$s_tag_namespace\"" || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/namespaces")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_namespaces_verify" "$i_status" "200" "$s_body" || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify readonly_namespace" "200" "200" "$s_body" "\"namespace\":\"$s_readonly_namespace\"" || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify readonly_state" "200" "200" "$s_body" '"policy_state":"readonly"' || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify readonly_action" "200" "200" "$s_body" '"last_policy_reject_action":"set"' || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify ttl_state" "200" "200" "$s_body" '"policy_state":"ttl_required"' || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify tag_state" "200" "200" "$s_body" '"policy_state":"tag_required"' || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify tag_persistent" "200" "200" "$s_body" '"persistent_count":1' || return 1
	proc_check "$s_case_prefix bus_policy_namespaces_verify disabled_state" "200" "200" "$s_body" '"policy_state":"disabled"' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/remove?all=true")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_remove_all_post" "$i_status" "200" "$s_body" '"result":true' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/limits?readonly_namespaces=&disabled_namespaces=&ttl_required_namespaces=&tag_required_namespaces=&data_limit=0&queue_limit=0&namespace_limit=0&namespace_data_limit=0")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_limits_clear_post" "$i_status" "200" "$s_body" '"updated":true' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_post readonly" "200" "200" "$s_body" '"readonly_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_post disabled" "200" "200" "$s_body" '"disabled_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_post ttl" "200" "200" "$s_body" '"ttl_required_namespaces":""' || return 1
	proc_check "$s_case_prefix bus_policy_limits_clear_post tag" "200" "200" "$s_body" '"tag_required_namespaces":""' || return 1

	i_status=$(proc_fetch_status "$s_base_url/__xs/bus/reset")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_prefix bus_policy_reset_post" "$i_status" "200" "$s_body" '"sweep_count"' || return 1
	return 0
}

proc_check_security_headers() {
	s_name="$1"
	s_method="$2"
	s_url="$3"

	s_body=$(proc_fetch_header_method "$s_method" "$s_url" "Cache-Control")
	proc_check "$s_name cache" "200" "200" "$s_body" 'no-store' || return 1
	s_body=$(proc_fetch_header_method "$s_method" "$s_url" "X-Frame-Options")
	proc_check "$s_name frame" "200" "200" "$s_body" 'DENY' || return 1
	s_body=$(proc_fetch_header_method "$s_method" "$s_url" "Referrer-Policy")
	proc_check "$s_name referrer" "200" "200" "$s_body" 'no-referrer' || return 1
	s_body=$(proc_fetch_header_method "$s_method" "$s_url" "X-Content-Type-Options")
	proc_check "$s_name nosniff" "200" "200" "$s_body" 'nosniff' || return 1

	return 0
}

proc_check_disabled_endpoint() {
	s_exe_name="$1"
	s_name="$2"
	s_method="$3"
	s_path="$4"
	i_expect_status="$5"
	s_content_type="$6"
	s_expect_body="${7:-}"
	s_url="http://127.0.0.1:$PORT$s_path"

	i_status=$(proc_fetch_status_method "$s_method" "$s_url")
	s_body=$(proc_fetch_body)
	if [ "$i_status" = "0" ]; then
		sleep 0.1
		i_status=$(proc_fetch_status_method "$s_method" "$s_url")
		s_body=$(proc_fetch_body)
	fi
	proc_check "$s_exe_name $s_name" "$i_status" "$i_expect_status" "$s_body" || return 1

	if [ -n "$s_expect_body" ]; then
		proc_check "$s_exe_name $s_name body" "$i_expect_status" "$i_expect_status" "$s_body" "$s_expect_body" || return 1
	fi

	s_body=$(proc_fetch_cached_header "Content-Type")
	proc_check "$s_exe_name $s_name type" "200" "200" "$s_body" "$s_content_type" || return 1
	s_body=$(proc_fetch_cached_header "Cache-Control")
	proc_check "$s_exe_name $s_name cache" "200" "200" "$s_body" 'no-store' || return 1
	s_body=$(proc_fetch_cached_header "X-Frame-Options")
	proc_check "$s_exe_name $s_name frame" "200" "200" "$s_body" 'DENY' || return 1
	s_body=$(proc_fetch_cached_header "Referrer-Policy")
	proc_check "$s_exe_name $s_name referrer" "200" "200" "$s_body" 'no-referrer' || return 1
	s_body=$(proc_fetch_cached_header "X-Content-Type-Options")
	proc_check "$s_exe_name $s_name nosniff" "200" "200" "$s_body" 'nosniff' || return 1
	return 0
}

proc_check_method_reject() {
	s_exe_name="$1"
	s_name="$2"
	s_method="$3"
	s_path="$4"
	i_expect_status="$5"
	s_allow="$6"
	s_content_type="$7"
	s_url="http://127.0.0.1:$PORT$s_path"

	i_status=$(proc_fetch_status_method "$s_method" "$s_url")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_name" "$i_status" "$i_expect_status" "$s_body" || return 1
	s_body=$(proc_fetch_allow_method "$s_method" "$s_url")
	proc_check "$s_exe_name $s_name allow" "200" "200" "$s_body" "$s_allow" || return 1
	s_body=$(proc_fetch_header_method "$s_method" "$s_url" "Content-Type")
	proc_check "$s_exe_name $s_name type" "200" "200" "$s_body" "$s_content_type" || return 1
	proc_check_security_headers "$s_exe_name $s_name" "$s_method" "$s_url" || return 1
	return 0
}

proc_run_production_app_pass_through_checks() {
	s_exe_name="$1"
	s_name_prefix="${2:-}"
	s_case_name="$s_exe_name"

	if [ -n "$s_name_prefix" ]; then
		s_case_name="$s_case_name $s_name_prefix"
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_name json_route" "$i_status" "200" "$s_body" '"path":"/json"' || return 1
	s_body=$(proc_fetch_header_method "GET" "http://127.0.0.1:$PORT/json" "Content-Type")
	proc_check "$s_case_name json_route type" "200" "200" "$s_body" 'application/json' || return 1

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_name passthrough_status_json" "$i_status" "200" "$s_body" 'path=/__xs/status_json' || return 1
	proc_check "$s_case_name passthrough_status_json method" "200" "200" "$s_body" 'method=GET' || return 1
	s_body=$(proc_fetch_header_method "GET" "http://127.0.0.1:$PORT/__xs/status_json" "Content-Type")
	proc_check "$s_case_name passthrough_status_json type" "200" "200" "$s_body" 'text/plain' || return 1

	i_status=$(proc_fetch_status_method "HEAD" "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_case_name passthrough_status_json_head" "$i_status" "200" "$s_body" || return 1
	s_body=$(proc_fetch_header_method "HEAD" "http://127.0.0.1:$PORT/__xs/status_json" "Content-Type")
