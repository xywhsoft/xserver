#!/bin/sh

set -eu

PORT=8085
XTP_PORT=9096
WAIT_SECS=10
CONFIG="${1:-xs_manage_test.json}"
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
RELEASE_DIR="$REPO_ROOT/release"
TOOL_DIR="$REPO_ROOT/tools"
INDEX_FILE="$RELEASE_DIR/wwwroot/index.html"
BODY_FILE="$TOOL_DIR/.xs_stable_smoke_body.tmp"
HEADER_FILE="$TOOL_DIR/.xs_stable_smoke_header.tmp"
ROOT_MEM_REPORT="$REPO_ROOT/xrt_mem_report_auto.json"
RELEASE_MEM_REPORT="$RELEASE_DIR/xrt_mem_report_auto.json"
OS_NAME=$(uname -s 2>/dev/null || echo unknown)
RUN_TAG=$$

case "$OS_NAME" in
	MINGW*|MSYS*|CYGWIN*|Windows_NT)
	powershell -ExecutionPolicy Bypass -File "$TOOL_DIR/xs_stable_smoke.ps1" "$CONFIG"
	exit $?
	;;
esac

XS_BIN="xs"
XSDBG_BIN="xsdbg"
CLIENT_EXT=""
CLIENT_LIBS=""

proc_fetch_status() {
	curl -s -D "$HEADER_FILE" -o "$BODY_FILE" -w "%{http_code}" "$1"
}

proc_fetch_status_method() {
	s_method="$1"
	s_url="$2"
	if [ "$s_method" = "HEAD" ]; then
		curl -s -I -D "$HEADER_FILE" -o "$BODY_FILE" -w "%{http_code}" "$s_url"
		return
	fi
	curl -s -X "$s_method" -D "$HEADER_FILE" -o "$BODY_FILE" -w "%{http_code}" "$s_url"
}

proc_fetch_allow_method() {
	proc_fetch_header_method "$1" "$2" "Allow"
}

proc_fetch_header_method() {
	s_method="$1"
	s_url="$2"
	s_header_name="$3"

	if [ "$s_method" = "HEAD" ]; then
		curl -s -I -D - -o /dev/null "$s_url" | tr -d '\r' | grep -i "^$s_header_name:" | tail -n 1 | sed -E 's/^[^:]+:[[:space:]]*//'
		return
	fi

	curl -s -X "$s_method" -D - -o /dev/null "$s_url" | tr -d '\r' | grep -i "^$s_header_name:" | tail -n 1 | sed -E 's/^[^:]+:[[:space:]]*//'
}

proc_fetch_body() {
	cat "$BODY_FILE"
}

proc_fetch_cached_header() {
	s_header_name="$1"
	if [ ! -f "$HEADER_FILE" ]; then
		return
	fi
	tr -d '\r' < "$HEADER_FILE" | grep -i "^$s_header_name:" | tail -n 1 | sed -E 's/^[^:]+:[[:space:]]*//'
}

proc_fetch_body_method() {
	s_method="$1"
	s_url="$2"

	if [ "$s_method" = "GET" ]; then
		curl -s "$s_url"
		return
	fi

	curl -s -X "$s_method" "$s_url"
}

proc_get_file_hash() {
	s_path="$1"
	if [ ! -f "$s_path" ]; then
		echo "(missing)"
		return
	fi

	sha256sum "$s_path" | awk '{print $1}'
}

proc_wait_ready() {
	i=0
	while [ "$i" -lt $((WAIT_SECS * 5)) ]; do
		if [ "$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json" || true)" = "200" ]; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.2
	done
	return 1
}

proc_wait_not_ready() {
	i=0
	while [ "$i" -lt $((WAIT_SECS * 5)) ]; do
		if [ "$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json" || true)" != "200" ]; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.2
	done
	return 1
}

proc_wait_reload_idle() {
	i=0
	while [ "$i" -lt $((WAIT_SECS * 5)) ]; do
		i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json" || true)
		s_body=$(proc_fetch_body 2>/dev/null || true)
		if [ "$i_status" = "200" ] && ! printf "%s" "$s_body" | grep -F '"busy":true' >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.2
	done
	return 1
}

proc_wait_body_contains() {
	s_url="$1"
	s_expect_text="$2"
	i=0

	while [ "$i" -lt $((WAIT_SECS * 5)) ]; do
		i_status=$(proc_fetch_status "$s_url" || true)
		s_body=$(proc_fetch_body 2>/dev/null || true)
		if [ "$i_status" = "200" ] && printf "%s" "$s_body" | grep -F "$s_expect_text" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.2
	done

	return 1
}

proc_json_string_field() {
	s_json="$1"
	s_field="$2"
	printf "%s" "$s_json" | sed -n "s/.*\"$s_field\":\"\([^\"]*\)\".*/\1/p" | head -n 1
}

proc_json_int_field() {
	s_json="$1"
	s_field="$2"
	printf "%s" "$s_json" | sed -n "s/.*\"$s_field\":\(-\{0,1\}[0-9][0-9]*\).*/\1/p" | head -n 1
}

proc_run_targeted_config_reload_checks() {
	s_exe_name="$1"
	s_host_query='%E9%BB%98%E8%AE%A4%E4%B8%BB%E6%9C%BA'

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	if [ "$i_status" != "200" ]; then
		echo "FAIL $s_exe_name targeted_reload status_json : $i_status"
		return 1
	fi

	s_server_name=$(proc_json_string_field "$s_body" "server")
	if [ -z "$s_server_name" ]; then
		echo "FAIL $s_exe_name targeted_reload server_name : missing"
		return 1
	fi

	s_server_query=$(printf "%s" "$s_server_name" | sed 's/ /%20/g')

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_reload_idle_wait : timeout"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_exe_name targeted_server_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || return 1
	proc_check_security_headers "$s_exe_name targeted_server_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || return 1

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_reload_idle_after : timeout"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server unchanged"'; then
		echo "FAIL $s_exe_name targeted_server_reload_status : missing text '\"message\":\"target server unchanged\"'"
		return 1
	fi
	
	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_reload_status" "$i_status" "200" "$s_body" '"message":"target server unchanged"' || return 1
	proc_check_security_headers "$s_exe_name targeted_server_reload_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || return 1

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_host_reload_idle_wait : timeout"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query&host=$s_host_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_host_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_exe_name targeted_host_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || return 1
	proc_check_security_headers "$s_exe_name targeted_host_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query&host=$s_host_query" || return 1

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_host_reload_idle_after : timeout"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target host unchanged"'; then
		echo "FAIL $s_exe_name targeted_host_reload_status : missing text '\"message\":\"target host unchanged\"'"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_host_reload_status" "$i_status" "200" "$s_body" '"message":"target host unchanged"' || return 1
	proc_check_security_headers "$s_exe_name targeted_host_reload_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || return 1

	s_config_path="$RELEASE_DIR/$CONFIG"
	s_config_backup="$TOOL_DIR/.xs_targeted_reload_${RUN_TAG}.json.bak"

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name targeted_server_soft_reload config_path : missing"
		return 1
	fi
	proc_run_targeted_server_host_topology_soft_reload_check "$s_exe_name" "$s_server_name" "$s_server_query" "$s_config_path" || return 1

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	if [ "$i_status" != "200" ]; then
		echo "FAIL $s_exe_name targeted_server_soft_reload status_json_before : $i_status"
		return 1
	fi

	i_path_limit_old=$(proc_json_int_field "$s_body" "path_limit")
	if [ -z "$i_path_limit_old" ]; then
		echo "FAIL $s_exe_name targeted_server_soft_reload path_limit_before : missing"
		return 1
	fi
	i_path_limit_new=$((i_path_limit_old + 7))

	cp "$s_config_path" "$s_config_backup"
	sed "0,/\"path_limit\"[[:space:]]*:[[:space:]]*[0-9][0-9]*/s//\"path_limit\": $i_path_limit_new/" "$s_config_backup" > "$s_config_path"
	if cmp -s "$s_config_backup" "$s_config_path"; then
		echo "FAIL $s_exe_name targeted_server_soft_reload config_replace : path_limit not replaced"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_soft_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_soft_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_idle_after : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_status : missing text '\"message\":\"target server soft reload success\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_soft_reload_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_status_json" "$i_status" "200" "$s_body" '"path_limit":' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	i_path_limit_now=$(proc_json_int_field "$s_body" "path_limit")
	proc_check "$s_exe_name targeted_server_soft_reload_path_limit" "$i_path_limit_now" "$i_path_limit_new" "$s_body" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"
	rm -f "$s_config_backup"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_restore_idle_wait_before : timeout"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_restore_config_json" "$i_status" "200" "$s_body" '"result":true' || return 1
	proc_check "$s_exe_name targeted_server_soft_reload_restore_config_json body" "200" "200" "$s_body" 'config reload queued' || return 1
	proc_check_security_headers "$s_exe_name targeted_server_soft_reload_restore_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || return 1

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_restore_idle_after : timeout"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name targeted_server_soft_reload_restore_status : missing text '\"message\":\"target server soft reload success\"'"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_restore_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || return 1
	proc_check_security_headers "$s_exe_name targeted_server_soft_reload_restore_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || return 1

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_soft_reload_restore_status_json" "$i_status" "200" "$s_body" '"path_limit":' || return 1
	i_path_limit_now=$(proc_json_int_field "$s_body" "path_limit")
	proc_check "$s_exe_name targeted_server_soft_reload_restore_path_limit" "$i_path_limit_now" "$i_path_limit_old" "$s_body" || return 1

	proc_run_manage_http_listener_soft_reload_check \
		"$s_exe_name" \
		"$CONFIG" \
		"$s_server_name" || return 1

	return 0
}

proc_run_targeted_server_host_topology_soft_reload_check() {
	s_exe_name="$1"
	s_server_name="$2"
	s_server_query="$3"
	s_config_path="$4"
	s_config_backup="$TOOL_DIR/.xs_targeted_reload_host_topology_${RUN_TAG}.json.bak"
	s_reload_host_header="reload.local"
	s_default_host_name="榛樿涓绘満"

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload config_path : missing"
		return 1
	fi

	cp "$s_config_path" "$s_config_backup"
	if ! awk -v s_server_name="$s_server_name" '
function brace_delta(line,    i, ch, i_delta, b_in_string, b_escape)
{
	i_delta = 0
	b_in_string = 0
	b_escape = 0
	for ( i = 1; i <= length(line); i++ ) {
		ch = substr(line, i, 1)
		if ( b_escape ) {
			b_escape = 0
			continue
		}
		if ( ch == "\\" && b_in_string ) {
			b_escape = 1
			continue
		}
		if ( ch == "\"" ) {
			b_in_string = !b_in_string
			continue
		}
		if ( b_in_string ) {
			continue
		}
		if ( ch == "{" ) {
			i_delta++
		} else if ( ch == "}" ) {
			i_delta--
		}
	}
	return i_delta
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
	b_replaced = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target && !b_replaced && $0 ~ "\"hosts\"[[:space:]]*:[[:space:]]*\\[[[:space:]]*\\]" ) {
		print "\t\t\t\"hosts\": ["
		print "\t\t\t\t{"
		print "\t\t\t\t\t\"enabled\": true,"
		print "\t\t\t\t\t\"name\": \"reload.local\","
		print "\t\t\t\t\t\"host\": \"reload.local\","
		print "\t\t\t\t\t\"debug\": true,"
		print "\t\t\t\t\t\"path\": \"wwwroot\","
		print "\t\t\t\t\t\"devlang\": \"c\","
		print "\t\t\t\t\t\"devfile\": \"script_vnext/main.c\""
		print "\t\t\t\t}"
		print "\t\t\t]"
		b_replaced = 1
		next
	}
	print
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
END {
	if ( !b_replaced ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload config_replace : named host not added"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	if cmp -s "$s_config_backup" "$s_config_path"; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload config_replace : named host not added"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_host_topology_soft_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload idle_after : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload status : missing text '\"message\":\"target server soft reload success\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_host_topology_soft_reload_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(curl -s -H "Host: $s_reload_host_header" -D "$HEADER_FILE" -o "$BODY_FILE" -w "%{http_code}" "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_host_added" "$i_status" "200" "$s_body" '"host":"reload.local"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_host_added path" "200" "200" "$s_body" '"path":"/json"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_restore_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_restore_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_host_topology_soft_reload_restore_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json?server=$s_server_query" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload restore_idle_after : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"target server soft reload success"'; then
		echo "FAIL $s_exe_name targeted_server_host_topology_soft_reload restore_status : missing text '\"message\":\"target server soft reload success\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_restore_status" "$i_status" "200" "$s_body" '"message":"target server soft reload success"' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_restore_status server" "200" "200" "$s_body" "\"server\":\"$s_server_name\"" || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name targeted_server_host_topology_soft_reload_restore_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(curl -s -H "Host: $s_reload_host_header" -D "$HEADER_FILE" -o "$BODY_FILE" -w "%{http_code}" "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_host_restored" "$i_status" "200" "$s_body" "\"host\":\"$s_default_host_name\"" || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name targeted_server_host_topology_soft_reload_host_restored path" "200" "200" "$s_body" '"path":"/json"' || {
		rm -f "$s_config_backup"
		return 1
	}

	rm -f "$s_config_backup"
	return 0
}

proc_run_service_add_remove_reload_check() {
	s_exe_name="$1"
	s_config_name="$2"
	s_udp_client_exe="$3"
	s_case_name="config_reload_service_add_remove"
	s_config_path="$RELEASE_DIR/$s_config_name"
	s_config_backup="$TOOL_DIR/.xs_service_add_remove_${RUN_TAG}.json.bak"
	s_added_server_name="test Reload Added UDP Server"
	i_udp_port_add=9098
	s_out=""
	i_status=0
	s_body=""

	if [ "$s_config_name" != "xs_manage_test.json" ]; then
		return 0
	fi

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name $s_case_name config_path : missing"
		return 1
	fi

	if s_out=$("$s_udp_client_exe" 127.0.0.1 "$i_udp_port_add" smoke-udp-added 2>&1); then
		echo "FAIL $s_exe_name $s_case_name probe_before : udp port already active"
		return 1
	fi
	echo "OK   $s_exe_name $s_case_name probe_before : 0"

	cp "$s_config_path" "$s_config_backup"
	if ! awk -v s_added_server_name="$s_added_server_name" '
function bracket_delta(line,    i, ch, i_delta, b_in_string, b_escape)
{
	i_delta = 0
	b_in_string = 0
	b_escape = 0
	for ( i = 1; i <= length(line); i++ ) {
		ch = substr(line, i, 1)
		if ( b_escape ) {
			b_escape = 0
			continue
		}
		if ( ch == "\\" && b_in_string ) {
			b_escape = 1
			continue
		}
		if ( ch == "\"" ) {
			b_in_string = !b_in_string
			continue
		}
		if ( b_in_string ) {
			continue
		}
		if ( ch == "[" ) {
			i_delta++
		} else if ( ch == "]" ) {
			i_delta--
		}
	}
	return i_delta
}
BEGIN {
	i_bracket_depth = 0
	b_in_services = 0
	b_inserted = 0
	b_exists = 0
	i_service_count = 0
}
{
	if ( $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_added_server_name "\"" ) {
		b_exists = 1
	}

	if ( !b_in_services && $0 ~ "\"services\"[[:space:]]*:[[:space:]]*\\[" ) {
		b_in_services = 1
	}

	if ( b_in_services && i_bracket_depth == 1 && index($0, "{") > 0 ) {
		i_service_count++
	}

	if ( b_in_services && !b_inserted && i_bracket_depth == 1 && $0 ~ "^[[:space:]]*\\]" ) {
		if ( b_exists ) {
			exit 4
		}
		if ( i_service_count > 0 ) {
			print "\t\t,"
		}
		print "\t\t{"
		print "\t\t\t\"enabled\": true,"
		print "\t\t\t\"class\": \"udp\","
		print "\t\t\t\"name\": \"test Reload Added UDP Server\","
		print "\t\t\t\"desc\": \"vNext reload add/remove udp smoke\","
		print "\t\t\t\"recv_limit\": 1048576,"
		print "\t\t\t\"idle_timeout\": 3000,"
		print "\t\t\t\"ip\": \"0.0.0.0\","
		print "\t\t\t\"port\": 9098,"
		print "\t\t\t\"debug\": true,"
		print "\t\t\t\"path\": \"script_vnext\","
		print "\t\t\t\"devlang\": \"c\","
		print "\t\t\t\"devfile\": \"script_vnext/udp_main.c\""
		print "\t\t}"
		b_inserted = 1
	}

	print
	i_bracket_depth += bracket_delta($0)

	if ( b_in_services && i_bracket_depth == 0 ) {
		b_in_services = 0
	}
}
END {
	if ( b_exists ) {
		exit 4
	}
	if ( !b_inserted ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : service not added"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	if cmp -s "$s_config_backup" "$s_config_path"; then
		echo "FAIL $s_exe_name $s_case_name config_replace : service not added"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name idle_wait_before : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name idle_after : timeout"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"config reload success: service add/remove only"'; then
		echo "FAIL $s_exe_name $s_case_name status : missing text '\"message\":\"config reload success: service add/remove only\"'"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name status" "$i_status" "200" "$s_body" '"message":"config reload success: service add/remove only"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name json_route" "$i_status" "200" "$s_body" '"path":"/json"' || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	if ! s_out=$("$s_udp_client_exe" 127.0.0.1 "$i_udp_port_add" smoke-udp-added 2>&1); then
		echo "FAIL $s_exe_name $s_case_name added_client : client exit"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	fi
	proc_check_output_tokens "$s_exe_name $s_case_name added_client" "$s_out" "udp demo" "data=smoke-udp-added" "" || {
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
		return 1
	}

	cp "$s_config_backup" "$s_config_path"

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name restore_idle_wait_before : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_config_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_reload_config_json" "$i_status" "200" "$s_body" '"result":true' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check "$s_exe_name $s_case_name restore_reload_config_json body" "200" "200" "$s_body" 'config reload queued' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name restore_reload_config_json" "GET" "http://127.0.0.1:$PORT/__xs/reload_config_json" || {
		rm -f "$s_config_backup"
		return 1
	}

	if ! proc_wait_reload_idle; then
		echo "FAIL $s_exe_name $s_case_name restore_idle_after : timeout"
		rm -f "$s_config_backup"
		return 1
	fi

	if ! proc_wait_body_contains "http://127.0.0.1:$PORT/__xs/reload_status_json" '"message":"config reload success: service add/remove only"'; then
		echo "FAIL $s_exe_name $s_case_name restore_status : missing text '\"message\":\"config reload success: service add/remove only\"'"
		rm -f "$s_config_backup"
		return 1
	fi

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/__xs/reload_status_json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_status" "$i_status" "200" "$s_body" '"message":"config reload success: service add/remove only"' || {
		rm -f "$s_config_backup"
		return 1
	}
	proc_check_security_headers "$s_exe_name $s_case_name restore_status" "GET" "http://127.0.0.1:$PORT/__xs/reload_status_json" || {
		rm -f "$s_config_backup"
		return 1
	}

	i_status=$(proc_fetch_status "http://127.0.0.1:$PORT/json")
	s_body=$(proc_fetch_body)
	proc_check "$s_exe_name $s_case_name restore_json_route" "$i_status" "200" "$s_body" '"path":"/json"' || {
		rm -f "$s_config_backup"
		return 1
	}

	if s_out=$("$s_udp_client_exe" 127.0.0.1 "$i_udp_port_add" smoke-udp-added-restore 2>&1); then
		echo "FAIL $s_exe_name $s_case_name removed_client : udp service still active"
		rm -f "$s_config_backup"
		return 1
	fi
	echo "OK   $s_exe_name $s_case_name removed_client : 0"

	rm -f "$s_config_backup"
	return 0
}

proc_check_output_tokens() {
	s_name="$1"
	s_out="$2"
	shift 2

	for s_token in "$@"; do
		if [ -n "$s_token" ] && ! printf "%s" "$s_out" | grep -F "$s_token" >/dev/null 2>&1; then
			echo "FAIL $s_name : unexpected body"
			return 1
		fi
	done

	echo "OK   $s_name : 0"
	return 0
}

proc_run_xtp_tls_listener_soft_reload_check() {
	s_exe_name="$1"
	s_config="$2"
	s_server_name="$3"
	s_client_exe="$4"
	s_probe_exe="$5"
	s_config_path="$RELEASE_DIR/$s_config"
	s_config_backup="$TOOL_DIR/.xtp_tls_listener_${RUN_TAG}.json.bak"
	s_server_query=$(printf "%s" "$s_server_name" | sed 's/ /%20/g')
	i_tls_port=9443
	s_out=""
	i_status=0
	s_body=""

	if [ ! -f "$s_config_path" ]; then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload config_path : missing"
		return 1
	fi

	if s_out=$("$s_probe_exe" 127.0.0.1 "$i_tls_port" 2>&1); then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload probe_before : tls port already open"
		return 1
	fi
	proc_check_output_tokens \
		"$s_exe_name xtp_tls_listener_soft_reload probe_before" \
		"$s_out" \
		"status=closed" \
		"port=$i_tls_port" \
		"" || return 1

	cp "$s_config_path" "$s_config_backup"
	if ! awk -v s_server_name="$s_server_name" '
function brace_delta(line,    i, ch, i_delta, b_in_string, b_escape)
{
	i_delta = 0
	b_in_string = 0
	b_escape = 0
	for ( i = 1; i <= length(line); i++ ) {
		ch = substr(line, i, 1)
		if ( b_escape ) {
			b_escape = 0
			continue
		}
		if ( ch == "\\" && b_in_string ) {
			b_escape = 1
			continue
		}
		if ( ch == "\"" ) {
			b_in_string = !b_in_string
			continue
		}
		if ( b_in_string ) {
			continue
		}
		if ( ch == "{" ) {
			i_delta++
		} else if ( ch == "}" ) {
			i_delta--
		}
	}
	return i_delta
}
BEGIN {
	i_depth = 0
	b_in_service = 0
	b_target = 0
	b_injected = 0
}
{
	i_prev_depth = i_depth
	if ( i_prev_depth == 1 && index($0, "{") > 0 ) {
		b_in_service = 1
		b_target = 0
	}
	if ( b_in_service && $0 ~ "\"name\"[[:space:]]*:[[:space:]]*\"" s_server_name "\"" ) {
		b_target = 1
	}
	if ( b_in_service && b_target && !b_injected && $0 ~ "\"debug\"[[:space:]]*:[[:space:]]*true" ) {
		print "\t\t\"tls\": true,"
		print "\t\t\"port_tls\": 9443,"
		print "\t\t\"tls_cert\": \"tls/xtps_cert.pem\","
		print "\t\t\"tls_key\": \"tls/xtps_key.pem\","
		b_injected = 1
	}
	print
	i_depth += brace_delta($0)
	if ( b_in_service && i_prev_depth == 2 && i_depth == 1 ) {
		b_in_service = 0
		b_target = 0
	}
}
END {
	if ( !b_injected ) {
		exit 3
	}
}
' "$s_config_backup" > "$s_config_path"; then
		echo "FAIL $s_exe_name xtp_tls_listener_soft_reload config_replace : tls listener not added"
		cp "$s_config_backup" "$s_config_path"
		rm -f "$s_config_backup"
