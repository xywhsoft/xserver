	proc_check "$s_case_name passthrough_dashboard_json_head type" "200" "200" "$s_body" 'text/plain' || return 1

	i_status=$(proc_fetch_status_method "POST" "http://127.0.0.1:$PORT/__xs/dashboard_json")
