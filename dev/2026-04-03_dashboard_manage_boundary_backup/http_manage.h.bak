		return "check config clear api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/http_metrics") == 0 ) {
		return "http metrics api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/http_metrics_json") == 0 ) {
		return "http metrics json api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/http_metrics_clear") == 0 ) {
		return "http metrics clear api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/ws_metrics") == 0 ) {
		return "ws metrics api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/ws_metrics_json") == 0 ) {
		return "ws metrics json api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/ws_metrics_clear") == 0 ) {
		return "ws metrics clear api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/xtp_metrics") == 0 ) {
		return "xtp metrics api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/xtp_metrics_json") == 0 ) {
		return "xtp metrics json api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/xtp_metrics_clear") == 0 ) {
		return "xtp metrics clear api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/udp_metrics") == 0 ) {
		return "udp metrics api only available in xsdbg";
	}
	if ( strcmp(sPath, "/__xs/udp_metrics_json") == 0 ) {
		return "udp metrics json api only available in xsdbg";
	}
