/* extracted manage surface */

static inline bool XS_ManageAPIEnabled(const XS_ServerConfig* objServer, const XS_HostConfig* objHost)
{
	if ( objServer == NULL || objHost == NULL ) {
		return FALSE;
	}

	return objServer->Debug || objHost->Debug;
}

static inline bool XS_HttpPathExpectsJSONError(const char* sPath);
static inline bool XS_HttpPathReservedManage(const char* sPath);
static inline const char* XS_HttpDebugOnlyAPIMessage(const char* sPath);

static inline bool XS_DebugManageAPIEnabled(const XS_ServerConfig* objServer, const XS_HostConfig* objHost)
{
	if ( !XS_ManageAPIEnabled(objServer, objHost) ) {
		return FALSE;
	}

#ifdef XRT_MEM_DEBUG
	return TRUE;
#else
	return FALSE;
#endif
}

static inline bool XS_BuiltinManageAppEnabled(void)
{
#ifdef XRT_MEM_DEBUG
	return TRUE;
#else
	return FALSE;
#endif
}

static inline bool XS_CoreManageAPIPath(const char* sPath)
{
	/*
	production xs stable surface:
	- keep this list close to the legacy thin-host baseline
	- do not add new built-in manage endpoints here unless docs/稳定API.md
	  and test_stable.* are updated together
	*/
	if ( !XS_BuiltinManageAppEnabled() || sPath == NULL || sPath[0] == '\0' ) {
		return FALSE;
	}

	return
		strcmp(sPath, "/__xs/status") == 0 ||
		strcmp(sPath, "/__xs/status_json") == 0 ||
		strcmp(sPath, "/__xs/health") == 0 ||
		strcmp(sPath, "/__xs/health_json") == 0 ||
		strcmp(sPath, "/__xs/reload") == 0 ||
		strcmp(sPath, "/__xs/reload_json") == 0 ||
		strcmp(sPath, "/__xs/reload_config") == 0 ||
		strcmp(sPath, "/__xs/reload_config_json") == 0 ||
		strcmp(sPath, "/__xs/reload_status") == 0 ||
		strcmp(sPath, "/__xs/reload_status_json") == 0 ||
		strcmp(sPath, "/__xs/check_config") == 0 ||
		strcmp(sPath, "/__xs/check_config_json") == 0;
}

static inline bool XS_DebugManageAPIPath(const char* sPath)
{
	/*
	xsdbg-only surface:
	- new built-in manage / debug / governance endpoints should land here first
	- production xs should stay thin unless the endpoint is explicitly frozen
	*/
	if ( !XS_BuiltinManageAppEnabled() || sPath == NULL || sPath[0] == '\0' ) {
		return FALSE;
	}

	return
		strcmp(sPath, "/__xs/reload_clear") == 0 ||
		strcmp(sPath, "/__xs/reload_reset") == 0 ||
		strcmp(sPath, "/__xs/check_config_clear") == 0 ||
		strcmp(sPath, "/__xs/http_metrics") == 0 ||
		strcmp(sPath, "/__xs/http_metrics_json") == 0 ||
		strcmp(sPath, "/__xs/http_metrics_clear") == 0 ||
		strcmp(sPath, "/__xs/ws_metrics") == 0 ||
		strcmp(sPath, "/__xs/ws_metrics_json") == 0 ||
		strcmp(sPath, "/__xs/ws_metrics_clear") == 0 ||
		strcmp(sPath, "/__xs/xtp_metrics") == 0 ||
		strcmp(sPath, "/__xs/xtp_metrics_json") == 0 ||
		strcmp(sPath, "/__xs/xtp_metrics_clear") == 0 ||
		strcmp(sPath, "/__xs/udp_metrics") == 0 ||
		strcmp(sPath, "/__xs/udp_metrics_json") == 0 ||
		strcmp(sPath, "/__xs/udp_metrics_clear") == 0 ||
		strcmp(sPath, "/__xs/custom_metrics") == 0 ||
		strcmp(sPath, "/__xs/custom_metrics_json") == 0 ||
		strcmp(sPath, "/__xs/custom_metrics_clear") == 0;
}

static inline bool XS_RuntimeManageAPIEnabled(const XS_ServerConfig* objServer, const XS_HostConfig* objHost, const char* sPath)
{
	if ( !XS_BuiltinManageAppEnabled() ) {
		return FALSE;
	}
	if ( !XS_ManageAPIEnabled(objServer, objHost) ) {
		return FALSE;
	}

#ifdef XRT_MEM_DEBUG
	(void)sPath;
	return TRUE;
#else
	return XS_CoreManageAPIPath(sPath);
#endif
}

static inline const char* XS_HttpProductionOnlyAPIMessage(const char* sPath)
{
	if ( sPath == NULL || sPath[0] == '\0' ) {
		return "extended manage api not included in production xs";
	}
	if ( XS_DebugManageAPIPath(sPath) ) {
		return XS_HttpDebugOnlyAPIMessage(sPath);
	}

	return "extended manage api not included in production xs";
}

static inline bool XS_HttpRespondProductionOnlyDisabled(const char* sPath, xhttpdresponse* pResp)
{
	const char* sMessage;

	if ( pResp == NULL ) {
		return FALSE;
	}

	sMessage = XS_HttpProductionOnlyAPIMessage(sPath);
	if ( XS_HttpPathExpectsJSONError(sPath) ) {
		return XS_HttpRespondJsonResult(pResp, 403, "Forbidden", FALSE, sMessage);
	}

	return XS_HttpRespondText(pResp, 403, "Forbidden", sMessage);
}

