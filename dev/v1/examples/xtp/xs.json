{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "examples xtp http server",
			"desc": "serve xtp log dashboard",
			"backlog": 128,
			"recv_limit": 1048576,
			"path_limit": 200,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "0.0.0.0",
			"port": 18280,
			"tls": false,
			"port_tls": 18680,
			"host_default": {
				"enabled": true,
				"name": "xtp http host",
				"path": "wwwroot",
				"debug": false,
				"devlang": "c",
				"devfile": "script/http_main.c"
			},
			"hosts": []
		},
		{
			"enabled": true,
			"class": "xtp",
			"name": "examples xtp service",
			"desc": "push log demo",
			"backlog": 128,
			"recv_limit": 1048576,
			"ip": "0.0.0.0",
			"port": 18294,
			"debug": false,
			"path": "script",
			"devlang": "c",
			"devfile": "script/xtp_main.c"
		}
	]
}
