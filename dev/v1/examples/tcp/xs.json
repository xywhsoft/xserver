{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "examples tcp http server",
			"desc": "serve tcp dashboard",
			"backlog": 128,
			"recv_limit": 1048576,
			"path_limit": 200,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "0.0.0.0",
			"port": 18380,
			"tls": false,
			"port_tls": 18780,
			"host_default": {
				"enabled": true,
				"name": "tcp http host",
				"path": "wwwroot",
				"debug": false,
				"devlang": "c",
				"devfile": "script/http_main.c"
			},
			"hosts": []
		},
		{
			"enabled": true,
			"class": "tcp",
			"name": "examples tcp peer server",
			"desc": "tcp point to point demo",
			"backlog": 128,
			"recv_limit": 1048576,
			"ip": "0.0.0.0",
			"port": 18392,
			"debug": false,
			"path": "script",
			"devlang": "c",
			"devfile": "script/tcp_main.c"
		}
	]
}
