{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "xywhsoft http server",
			"desc": "HTTP 多主机场景示例",
			"param": "demo-http",
			"ip": "0.0.0.0",
			"port": 80,
			"tls": true,
			"ip_tls": "0.0.0.0",
			"port_tls": 443,
			"host_default": {
				"enabled": true,
				"name": "默认主机",
				"desc": "主机描述",
				"param": "http-default",
				"path": "wwwroot",
				"tls_ca": null,
				"tls_cert": "tls/cert.pem",
				"tls_key": "tls/key.pem",
				"devlang": "c",
				"devfile": "script_vnext/main.c"
			},
			"hosts": []
		},
		{
			"enabled": true,
			"class": "ws",
			"name": "xywhsoft ws server",
			"desc": "WebSocket 示例",
			"param": "demo-ws",
			"ip": "0.0.0.0",
			"port": 8081,
			"tls": false,
			"host_default": {
				"enabled": true,
				"name": "默认主机",
				"desc": "WS 默认主机",
				"param": "ws-default",
				"path": "wwwroot",
				"devlang": "c",
				"devfile": "script_vnext/ws_main.c"
			},
			"hosts": []
		},
		{
			"enabled": true,
			"class": "custom",
			"name": "自定义服务",
			"desc": "自定义流协议示例",
			"param": "demo-custom",
			"ip": "0.0.0.0",
			"port": 9001,
			"tls": false,
			"path": "script_vnext",
			"devlang": "c",
			"devfile": "script_vnext/custom_main.c"
		}
	]
}
