{
	"services": [
	{
		"enabled": true,
		"class": "http",
		"name": "test Manage HTTP Server",
		"desc": "vNext manage interface test",
		"param": "manage",
		"backlog": 128,
		"recv_limit": 1048576,
		"path_limit": 200,
		"header_limit": 32,
		"body_limit": 262144,
		"ip": "0.0.0.0",
		"port": 8187,
		"debug": true,
		"host_default": {
			"enabled": true,
			"name": "默认主机",
			"debug": true,
			"path": "wwwroot",
			"devlang": "c",
			"devfile": "script_vnext/main.c"
		},
		"hosts": []
	},
	{
		"enabled": true,
		"class": "ws",
		"name": "test WebSocket Server",
		"desc": "vNext websocket idle timeout test",
		"backlog": 128,
		"recv_limit": 1048576,
		"ws_message_limit": 262144,
		"idle_timeout": 1000,
		"ws_protocol": "xs-demo",
		"ip": "0.0.0.0",
		"port": 8281,
		"debug": true,
		"host_default": {
			"enabled": true,
			"name": "默认主机",
			"path": "wwwroot",
			"devlang": "c",
			"devfile": "script_vnext/ws_main.c",
			"debug": true
		},
		"hosts": []
	}
	]
}
