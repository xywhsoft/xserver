{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "test HTTP Metrics Server",
			"debug": true,
			"backlog": 64,
			"recv_limit": 1048576,
			"path_limit": 512,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "127.0.0.1",
			"port": 8185,
			"host_default": {
				"enabled": true,
				"name": "http-metrics",
				"path": "wwwroot",
				"devlang": "c",
				"devfile": "script_vnext/main.c"
			}
		},
		{
			"enabled": true,
			"class": "http",
			"name": "test HTTP Idle Server",
			"debug": true,
			"backlog": 64,
			"conn_limit": 64,
			"recv_limit": 1048576,
			"idle_timeout": 1000,
			"path_limit": 512,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "127.0.0.1",
			"port": 8186,
			"host_default": {
				"enabled": true,
				"name": "http-idle",
				"path": "wwwroot",
				"devlang": "c",
				"devfile": "script_vnext/main.c"
			}
		}
	]
}
