				"path": "wwwroot",
				"devlang": "c",
				"devfile": "script_vnext/main.c"
			},
			{
				"enabled": true,
				"name": "static host",
				"host": "static.local",
				"debug": true,
				"path": "wwwroot"
			}
		]
	}
