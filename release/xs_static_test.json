{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "test Static Server",
			"desc": "static smoke server",
			"debug": true,
			"backlog": 128,
			"conn_limit": 64,
			"recv_limit": 1048576,
			"path_limit": 512,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "127.0.0.1",
			"port": 8082,
			"host_default": {
				"enabled": true,
				"name": "static",
				"path": "wwwroot",
				"devlang": "static",
				"headers": {
					"Access-Control-Allow-Origin": "*",
					"Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
					"Access-Control-Allow-Headers": "Content-Type",
					"Cache-Control": "public, max-age=86400"
				}
			}
		}
	]
}
