{
	"services": [
		{
			"enabled": true,
			"class": "http",
			"name": "examples custom http server",
			"desc": "serve custom scheduler dashboard",
			"backlog": 128,
			"recv_limit": 1048576,
			"path_limit": 200,
			"header_limit": 32,
			"body_limit": 262144,
			"ip": "0.0.0.0",
			"port": 18580,
			"tls": false,
			"port_tls": 18980,
			"host_default": {
				"enabled": true,
				"name": "custom http host",
				"path": "wwwroot",
				"debug": false,
				"devlang": "c",
				"devfile": "script/http_main.c"
			},
			"hosts": []
		},
		{
			"enabled": true,
			"class": "custom",
			"name": "examples custom scheduler service",
			"desc": "custom scheduled task demo",
			"backlog": 128,
			"recv_limit": 1048576,
			"ip": "0.0.0.0",
			"port": 18591,
			"debug": false,
			"path": "script",
			"devlang": "c",
			"devfile": "script/custom_main.c"
		}
	]
}
